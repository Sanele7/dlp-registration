# ============================================================
# COPY THIS FILE TO .env AND FILL IN LOCAL VALUES
#   cp .env.example .env
#
# .env is gitignored and must NEVER be committed.
# This file contains placeholders only — no real values.
# ============================================================

# --- LocalStack ---------------------------------------------
# Pinned version. Do not change without a decision record.
LOCALSTACK_VERSION=4.14.0
LOCALSTACK_ENDPOINT=http://localhost:4566
LOCALSTACK_DEBUG=0

# --- AWS SDK ------------------------------------------------
# LocalStack ignores these values but the SDK requires them.
# They are deliberately fake. Never put real AWS keys here.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# --- Application --------------------------------------------
REGISTRATIONS_TABLE=dlp-registrations
COUNTER_TABLE=dlp-capacity
LAMBDA_FUNCTION_NAME=dlp-registration-processor
PROGRAMME_CAPACITY=10
LOG_LEVEL=INFO
