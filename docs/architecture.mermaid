flowchart TB
    subgraph untrusted["UNTRUSTED — outside trust boundary"]
        A["Applicant<br/>submits registration"]
    end

    subgraph trusted["TRUST BOUNDARY"]
        B["API Gateway<br/>receives request<br/>invokes Lambda"]
        C["Lambda — registration processor<br/>STATELESS<br/>─────────────<br/>validate payload<br/>verify ID checksum<br/>derive age<br/>compute APS<br/>check duplicate"]
        D[("DynamoDB<br/>─────────────<br/>registration records<br/>DURABLE STATE")]
        G[("DynamoDB<br/>─────────────<br/>capacity counter<br/>single sentinel row")]
        E["CloudWatch Logs<br/>─────────────<br/>correlation ID<br/>decision + reason<br/>UTC timestamp"]
    end

    subgraph outside["OUTSIDE SYSTEM BOUNDARY — not implemented"]
        F["Intake verification<br/>documents checked in person<br/>PROVISIONAL → CONFIRMED"]
    end

    A -->|"HTTPS POST /registrations<br/>JSON payload"| B
    B -->|"invoke with event"| C
    C -->|"conditional UpdateItem<br/>decrement only if remaining > 0<br/>ATOMIC — prevents over-enrolment"| G
    G -.->|"success or<br/>ConditionalCheckFailed"| C
    C -->|"PutItem — registration record"| D
    C -->|"structured log<br/>accept / reject / error"| E
    C -->|"201 PROVISIONALLY_ACCEPTED<br/>422 REJECTED + reason<br/>409 DUPLICATE / FULL<br/>503 SERVICE_UNAVAILABLE"| B
    B -->|"HTTPS response<br/>+ correlation ID"| A
    D -.->|"record looked up<br/>by correlation ID"| F

    style A fill:#FAEEDA,stroke:#854F0B,color:#412402
    style B fill:#E6F1FB,stroke:#185FA5,color:#042C53
    style C fill:#EEEDFE,stroke:#534AB7,color:#26215C
    style D fill:#E1F5EE,stroke:#0F6E56,color:#04342C
    style G fill:#E1F5EE,stroke:#0F6E56,color:#04342C
    style E fill:#E1F5EE,stroke:#0F6E56,color:#04342C
    style F fill:#F1EFE8,stroke:#5F5E5A,color:#2C2C2A
