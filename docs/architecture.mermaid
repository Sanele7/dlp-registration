%%{init: {'theme': 'base', 'themeVariables': {'clusterBkg': '#FFFFFF', 'clusterBorder': '#000000', 'primaryColor': '#F2F2F2', 'primaryBorderColor': '#000000', 'primaryTextColor': '#000000', 'lineColor': '#000000', 'edgeLabelBackground': '#EDEDED', 'fontFamily': 'Arial', 'fontSize': '15px'}}}%%
flowchart LR
    subgraph untrusted["OUTSIDE TRUST BOUNDARY"]
        A["Applicant<br/>register.sh / check-status.sh"]
        OP["Operator<br/>admin.sh<br/>(own local credentials)"]
    end

    subgraph trusted["TRUST BOUNDARY — LocalStack 4.14.0 in Docker"]
        B["API Gateway<br/>POST /registrations<br/>POST /registrations/check<br/>POST /registrations/status"]
        C["Lambda — dlp-registration-processor<br/>STATELESS, python3.11, 128 MB<br/>──────────────<br/>1 residence  2 ID + checksum<br/>3 age 18-25  4 APS ≤ 20<br/>5 atomic write  6 reference + PIN"]
        D[("DynamoDB — dlp-registrations<br/>──────────────<br/>registration (idHash)<br/>REF# lookup (PIN hash)<br/>CAPACITY# counter (5)")]
        E["CloudWatch Logs<br/>──────────────<br/>correlation ID<br/>decision + reason<br/>6-char hash prefix"]
    end

    subgraph outside["OUTSIDE SYSTEM BOUNDARY — not implemented"]
        F["Branch helpdesk<br/>checks documents + proof<br/>of residence in person"]
    end

    A -->|"HTTPS JSON"| B
    B -->|"invoke"| C
    C -->|"TransactWriteItems (atomic)<br/>put registration + put REF#<br/>+ decrement seat if remaining > 0"| D
    C -->|"GetItem (duplicate, seats, status)"| D
    C -->|"structured log"| E
    C -->|"201 / 200 / 409 / 422 / 423 / 503<br/>+ correlation ID"| B
    OP -.->|"Scan (operator only)"| D
    A -.->|"brings documents"| F

    style A fill:#FFFFFF,stroke:#000000,color:#000000
    style OP fill:#FFFFFF,stroke:#000000,color:#000000
    style B fill:#F2F2F2,stroke:#000000,color:#000000
    style C fill:#E6E6E6,stroke:#000000,color:#000000
    style D fill:#F2F2F2,stroke:#000000,color:#000000
    style E fill:#F2F2F2,stroke:#000000,color:#000000
    style F fill:#FAFAFA,stroke:#000000,color:#000000
